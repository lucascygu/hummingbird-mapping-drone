<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>hummingbird_px4_bridge</name>
  <version>0.1.0</version>
  <description>Converts FAST-LIO2 odometry (ROS ENU/FLU) to PX4 VehicleOdometry (NED/FRD) on /fmu/in/vehicle_visual_odometry. Estimator input only: never arms, never commands.</description>
  <maintainer email="113392627+lucascygu@users.noreply.github.com">Lucas Changyao Gu</maintainer>
  <license>MIT</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>px4_msgs</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
